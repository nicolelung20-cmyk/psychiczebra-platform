# Optional standalone SupportFlow AI draft service settings
SUPPORTFLOW_API_KEYS=replace-with-a-long-random-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-latest

# Optional AUTOGROUP command center: live revenue from Stripe (read-only)
# Create a restricted Stripe key with only "Charges: Read". Never reuse STRIPE_SECRET_KEY here.
STRIPE_READ_KEY=rk_live_...
# Long random token the dashboard sends as x-dash-token; the revenue endpoint refuses to answer without it.
AUTOGROUP_DASH_TOKEN=replace-with-a-long-random-token
